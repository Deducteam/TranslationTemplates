Set : Type.
El : Set -> Type.
Prop : Type.
def Prf : Prop -> Type.

imp : Prop -> Prop -> Prop.
[p,q] Prf (imp p q) --> Prf p -> Prf q.

all : a : Set -> (El a -> Prop) -> Prop.
[a, p] Prf (all a p) --> (x : El a) -> Prf (p x).

nat : Set.
0 : El nat.
succ : El nat -> El nat.
geq : El nat -> El nat -> Prop.

ax_1 : x : El nat -> Prf (geq x x).
ax_2 : x : El nat -> y : El nat -> z : El nat -> 
        Prf (geq x y) -> Prf (geq y z) -> Prf (geq x z).
ax_3 : x : El nat -> Prf (geq (succ x) x).
ax_4 : x : El nat -> Prf (geq x (succ x)) -> P : Prop -> Prf P.

rec : P : (El nat -> Prop) -> 
        Prf (P 0) -> 
        (x : El nat -> Prf (P x) -> Prf (P (succ x))) ->
        x : El nat -> Prf (P x).

thm thm1 : (x : El nat) -> Prf (geq x 0)
  := x => rec 
    (z => geq z 0) 
    (ax_1 0)
    (x => Px => ax_2 (succ x) x 0 (ax_3 x) Px)
    x.

thm thm2 : x : El nat -> Prf (geq (succ x) 0)
  := x => ax_2 (succ x) x 0 (ax_3 x) (thm1 x).