tm : Type.
Set : Type.
Prop : Type.
def Prf : Prop -> Type.
oftype : tm -> Set -> Type.

imp : Prop -> Prop -> Prop.
[p,q] Prf (imp p q) --> Prf p -> Prf q.

all : a : Set -> (x : tm -> oftype x a -> Prop) -> Prop.
all_i : a : Set -> p : (x : tm -> oftype x a -> Prop) -> (x : tm -> h : oftype x a -> Prf (p x h)) -> Prf (all a p).
all_e : a : Set -> p : (x : tm -> oftype x a -> Prop) -> Prf (all a p) -> x : tm -> h : oftype x a -> Prf (p x h).