#REQUIRE int.

impd : (p : int.Prop) -> (int.Prf p -> int.Prop) -> int.Prop.
[p,q] int.Prf (impd p q) --> h : int.Prf p -> int.Prf (q h).

pair : a : int.Set -> (int.El a -> int.Prop) -> int.Set.
def mk_pair : a : int.Set -> p : (int.El a -> int.Prop) -> x : int.El a -> int.Prf (p x) -> int.El (pair a p).
def fst : a : int.Set -> p : (int.El a -> int.Prop) -> int.El (pair a p) -> int.El a.
def snd : a : int.Set -> p : (int.El a -> int.Prop) -> m : int.El (pair a p) -> int.Prf (p (fst a p m)).

[a, p, x, h] fst a p (mk_pair a p x h) --> x.
[a, p, x, h] snd a p (mk_pair a p x h) --> h.
[a, p, m] mk_pair a p (fst a p m) (snd a p m) --> m.

proof_irr : 
  (p : int.Prop) -> 
  (h1 : int.Prf p) -> 
  (h2 : int.Prf p) -> 
  (Q : (int.Prf p -> int.Prop)) -> 
  int.Prf (Q h1) -> int.Prf (Q h2).

def Set_mu : Type := int.Set.

def El_mu : Set_mu -> Type := int.El.

def Prop_mu : Type := int.Prop.

def Prf_mu : Prop_mu -> Type := int.Prf.

def imp_mu :
  Prop_mu -> Prop_mu -> Prop_mu
  :=
  int.imp.

def all_mu :
  a:Set_mu ->
  ((El_mu a) -> Prop_mu) -> Prop_mu
  :=
  int.all.

def nat_mu : Set_mu := pair int.int (x => int.geq x int.0).

def 0_mu : El_mu nat_mu := mk_pair int.int (x => int.geq x int.0) int.0 (int.ax_1 int.0).

def succ_mu :
  (El_mu nat_mu) -> El_mu nat_mu
  :=
  m => mk_pair int.int (x => int.geq x int.0) 
    (int.succ (fst int.int (x => int.geq x int.0) m)) 
    (int.ax_2 
      (int.succ (fst int.int (x => int.geq x int.0) m)) 
      (fst int.int (x => int.geq x int.0) m) 
      int.0 
      (int.ax_3 (fst int.int (x => int.geq x int.0) m)) 
      (snd int.int (x => int.geq x int.0) m)).

def geq_mu :
  (El_mu nat_mu) ->
  (El_mu nat_mu) -> Prop_mu
  :=
  m1 => m2 => int.geq (fst int.int (x => int.geq x int.0) m1) (fst int.int (x => int.geq x int.0) m2).

def ax_1_mu :
  x:(El_mu nat_mu) ->
  Prf_mu (geq_mu x x)
  :=
  m => int.ax_1 (fst int.int (x => int.geq x int.0) m).

def ax_2_mu :
  x:(El_mu nat_mu) ->
  y:(El_mu nat_mu) ->
  z:(El_mu nat_mu) ->
  (Prf_mu (geq_mu x y)) ->
  (Prf_mu (geq_mu y z)) ->
  Prf_mu (geq_mu x z)
  :=
  m1 => m2 => m3 => int.ax_2 
    (fst int.int (x => int.geq x int.0) m1) 
    (fst int.int (x => int.geq x int.0) m2) 
    (fst int.int (x => int.geq x int.0) m3).

def ax_3_mu :
  x:(El_mu nat_mu) ->
  Prf_mu (geq_mu (succ_mu x) x)
  :=
  m => int.ax_3 (fst int.int (x => int.geq x int.0) m).

def ax_4_mu :
  x:(El_mu nat_mu) ->
  (Prf_mu (geq_mu x (succ_mu x))) ->
  P:Prop_mu -> Prf_mu P
  :=
  m => h => P => int.ax_4 (fst int.int (x => int.geq x int.0) m) h P.

def rec_mu :
  P:((El_mu nat_mu) -> Prop_mu) ->
  (Prf_mu (P 0_mu)) ->
  (x:(El_mu nat_mu) ->
   (Prf_mu (P x)) -> Prf_mu (P (succ_mu x))) ->
  x:(El_mu nat_mu) -> Prf_mu (P x)
  :=
  P => H0 => HR => m => int.rec 
    (x => impd (int.geq x int.0) (h => P (mk_pair int.int (x => int.geq x int.0) x h)))
    (h => proof_irr (int.geq int.0 int.0) (int.ax_1 int.0) h (w => P (mk_pair int.int (x => int.geq x int.0) int.0 w)) H0)
    (x => hx => Hx => hsx => 
      proof_irr (int.geq (int.succ x) int.0)  
        (int.ax_2 (int.succ x) x int.0 (int.ax_3 x) hx)
        hsx
        (w => P (mk_pair int.int (x => int.geq x int.0) (int.succ x) w))
        (HR 
          (mk_pair int.int (x => int.geq x int.0) x hx)
          (Hx hx)))
    (x => hx => Hx => hpx => int.ax_6 x (int.ax_2 (int.pred x) (int.0) x hpx hx) (P (mk_pair int.int (x => int.geq x int.0) (int.pred x) hpx)))
    (fst int.int (x => int.geq x int.0) m)
    (snd int.int (x => int.geq x int.0) m).

thm thm1_mu :
  x:(El_mu nat_mu) ->
  Prf_mu (geq_mu x 0_mu)
  :=
  x =>
  rec_mu
    (z => geq_mu z 0_mu)
    (ax_1_mu 0_mu)
    (x0 =>
     Px =>
     ax_2_mu
       (succ_mu x0)
       x0
       0_mu
       (ax_3_mu x0)
       Px)
    x.

thm thm2_mu :
  x:(El_mu nat_mu) ->
  Prf_mu (geq_mu (succ_mu x) 0_mu)
  :=
  x =>
  ax_2_mu
    (succ_mu x)
    x
    0_mu
    (ax_3_mu x)
    (thm1_mu x).

