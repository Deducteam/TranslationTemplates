Set : Type.
El : Set -> Type.
tree : Set -> Type.
leaf : a : Set -> tree a.
node : a : Set -> El a -> tree a -> tree a -> tree a.
def left : a : Set -> tree a -> tree a.
def right : a : Set -> tree a -> tree a.
def root : a : Set -> tree a -> El a.

[a',a,x,l,r] left a' (node a x l r) --> l.
[a',a,x,l,r] right a' (node a x l r) --> r.
[a',a,x,l,r] root a' (node a x l r) --> x.