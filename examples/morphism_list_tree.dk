#REQUIRE tree.

def Set_mu : Type := tree.Set.

def El_mu : Set_mu -> Type := tree.El.

def list_mu : Set_mu -> Type := tree.tree.

def nil_mu :
  a:Set_mu -> list_mu a
  :=
  tree.leaf.

def cons_mu :
  a:Set_mu ->
  (El_mu a) -> (list_mu a) -> list_mu a
  :=
  a => x => l => tree.node a x l (tree.leaf a).

def hd_mu :
  a:Set_mu -> (list_mu a) -> El_mu a
  :=
  a => l => tree.root a l.

def tl_mu :
  a:Set_mu -> (list_mu a) -> list_mu a
  :=
  a => l => tree.left a l.

