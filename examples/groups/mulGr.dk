Prop : Type.
Prf : Prop -> Type.
imp : Prop -> Prop -> Prop.
and : Prop -> Prop -> Prop.

imp_i : p : Prop -> q : Prop -> (Prf p -> Prf q) -> Prf (imp p q).
imp_e : p : Prop -> q : Prop -> Prf (imp p q) -> Prf p -> Prf q.
and_i : p : Prop -> Prf p -> q : Prop -> Prf q -> Prf (and p q).
and_el : p : Prop -> q : Prop -> Prf (and p q) -> Prf p.
and_er : p : Prop -> q : Prop -> Prf (and p q) -> Prf q.

i : Type.
eq : i -> i -> Prop.
refl : x : i -> Prf (eq x x).
leib : x : i -> y : i -> Prf (eq x y) -> P : (i -> Prop) -> Prf (P x) -> Prf (P y).

def mul : i -> i -> i.
1 : i.
def inv : i -> i.
[x,y,z] mul (mul x y) z --> mul x (mul y z).
[x] mul x 1 --> x.
[x] mul 1 x --> x.
[x] mul x (inv x) --> 1.
[x] mul (inv x) x --> 1.
[] inv 1 --> 1.
[x] inv (inv x) --> x.
[x,y] mul (inv x) (mul x y) --> y.
[x,y] mul x (mul (inv x) y) --> y.
[x,y] inv (mul x y) --> mul (inv y) (inv x). 
